{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Swarmed",
    "identifier": "dev.kauneckas.swarmed",
    "build": {
        "beforeDevCommand": { "script": "pnpm dev", "cwd": "../.." },
        "beforeBuildCommand": { "script": "pnpm build", "cwd": "../.." },
        "devUrl": "http://localhost:5173",
        "frontendDist": "../../ui/dist"
    },
    "app": {
        "windows": [
            {
                "title": "Swarmed",
                "width": 1440,
                "height": 900,
                "minWidth": 960,
                "minHeight": 600,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; frame-src swarmed-view:"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app", "dmg"],
        "icon": [
            "icons/32x32.png",
            "icons/128x128.png",
            "icons/128x128@2x.png",
            "icons/icon.icns",
            "icons/icon.ico"
        ],
        "category": "DeveloperTool",
        "macOS": { "signingIdentity": "-" }
    },
    "plugins": {
        "updater": {
            "pubkey": "",
            "endpoints": ["https://github.com/ryckakas/swarmed/releases/latest/download/latest.json"],
            "requireSignedVersion": true
        }
    }
}
