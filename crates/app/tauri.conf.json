{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "Swarmed",
    "identifier": "dev.kauneckas.swarmed",
    "build": {
        "beforeDevCommand": { "script": "pnpm dev", "cwd": "../.." },
        "beforeBuildCommand": { "script": "pnpm build", "cwd": "../.." },
        "devUrl": "http://localhost:5173",
        "frontendDist": "../../ui/dist"
    },
    "app": {
        "windows": [
            {
                "title": "Swarmed",
                "width": 1440,
                "height": 900,
                "minWidth": 960,
                "minHeight": 600,
                "titleBarStyle": "Overlay",
                "hiddenTitle": true
            }
        ],
        "security": {
            "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
        }
    },
    "bundle": {
        "active": true,
        "targets": ["app", "dmg"],
        "icon": ["icons/icon.png"],
        "category": "DeveloperTool"
    }
}
