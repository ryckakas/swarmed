{
    "name": "swarmed-ui",
    "private": true,
    "version": "0.0.1",
    "type": "module",
    "license": "MIT",
    "packageManager": "pnpm@10.33.0",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "biome check",
        "format": "biome check --write",
        "complexity": "bonsai-lint ui/src",
        "test": "vitest run",
        "app": "tauri dev",
        "app:build": "tauri build"
    },
    "dependencies": {
        "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
        "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
        "@tauri-apps/api": "2.12.5",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "zustand": "5.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@tauri-apps/cli": "2.12.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "bonsai-lint": "0.5.1",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "bonsai-lint",
            "esbuild"
        ]
    }
}
