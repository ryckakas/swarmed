{
    "name": "swarmed-ui",
    "private": true,
    "version": "0.4.12",
    "type": "module",
    "license": "MIT",
    "packageManager": "pnpm@10.33.0+sha512.10568bb4a6afb58c9eb3630da90cc9516417abebd3fabbe6739f0ae795728da1491e9db5a544c76ad8eb7570f5c4bb3d6c637b2cb41bfdcdb47fa823c8649319",
    "scripts": {
        "dev": "vite",
        "build": "tsc --noEmit && vite build",
        "typecheck": "tsc --noEmit",
        "lint": "biome check",
        "format": "biome check --write",
        "complexity": "bonsai-lint ui/src",
        "test": "vitest run",
        "app": "tauri dev",
        "app:build": "tauri build --bundles app",
        "app:install": "tauri build --bundles app && ditto target/release/bundle/macos/Swarmed.app /Applications/Swarmed.app",
        "app:dmg": "tauri build --bundles dmg"
    },
    "dependencies": {
        "@fontsource-variable/atkinson-hyperlegible-mono": "5.3.0",
        "@fontsource-variable/atkinson-hyperlegible-next": "5.3.0",
        "@tauri-apps/api": "2.12.5",
        "@tauri-apps/plugin-dialog": "2.8.4",
        "@xterm/addon-clipboard": "0.2.0",
        "@xterm/addon-fit": "0.11.0",
        "@xterm/addon-search": "0.16.0",
        "@xterm/addon-unicode11": "0.9.0",
        "@xterm/addon-web-links": "0.12.0",
        "@xterm/addon-webgl": "0.19.0",
        "@xterm/xterm": "6.0.0",
        "katex": "0.19.1",
        "react": "19.3.1",
        "react-dom": "19.3.1",
        "react-markdown": "10.1.0",
        "rehype-highlight": "7.0.2",
        "rehype-katex": "7.0.1",
        "rehype-raw": "7.0.0",
        "rehype-sanitize": "6.0.0",
        "remark-gfm": "4.0.1",
        "remark-math": "6.0.0",
        "remark-parse": "11.0.0",
        "unified": "11.0.5",
        "zustand": "5.1.0"
    },
    "devDependencies": {
        "@biomejs/biome": "2.6.8",
        "@tauri-apps/cli": "2.12.6",
        "@types/react": "19.3.0",
        "@types/react-dom": "19.3.0",
        "@vitejs/plugin-react": "6.3.0",
        "bonsai-lint": "0.5.1",
        "typescript": "7.0.2",
        "vite": "8.3.8",
        "vitest": "5.1.1"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "bonsai-lint",
            "esbuild"
        ],
        "overrides": {
            "katex": "0.19.1"
        }
    }
}
